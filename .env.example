# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Generate local secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://payroll:payroll_dev_password@localhost:5432/payroll?schema=public
# Separate connection used by Prisma Migrate for shadow-database creation.
SHADOW_DATABASE_URL=postgresql://payroll:payroll_dev_password@localhost:5432/payroll_shadow?schema=public

# --- Auth -------------------------------------------------------------------
# MUST be replaced. Minimum 32 characters. Rotate via secret manager, never Git.
JWT_ACCESS_SECRET=replace_me_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_me_with_a_different_32_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
# Set to the first superadmin email so the seed can bootstrap them.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Redis (Phase 8: BullMQ worker) -----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Email (Phase 8: Nodemailer + SendGrid) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Payroll <no-reply@example.com>

# --- GCP Cloud Storage (Phase 7: payslip PDFs) ------------------------------
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
# Path to a service-account JSON key. Prefer workload identity in production.
GCP_SERVICE_ACCOUNT_KEY_PATH=

# --- Google OIDC (CI/CD -> Cloud Run, Phase 11) ------------------------------
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=